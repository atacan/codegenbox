#!/usr/bin/env python3
"""Run Codex with user-global hooks disabled only for this invocation."""
import json
import os
from pathlib import Path
import re
import sys
import tomllib


def overrides(home, arguments=()):
    # Codex 0.166's hook registry keys are absolute source path, snake-case
    # event, matcher index, handler index. SessionFlags override User state.
    # Preserve the private session CODEX_HOME for refreshes and saved history.
    states = {}
    paths = [home / "hooks.json", home / "config.toml"]
    for index, argument in enumerate(arguments):
        if argument == "--":
            break
        profile = None
        if argument in ("--profile", "-p") and index + 1 < len(arguments):
            profile = arguments[index + 1]
        elif argument.startswith("--profile="):
            profile = argument.split("=", 1)[1]
        elif argument.startswith("-p") and len(argument) > 2:
            profile = argument[2:]
        if profile:
            paths.append(home / f"{profile}.config.toml")
    for path in paths:
        if not path.is_file():
            continue
        with path.open("rb") as source:
            config = json.load(source) if path.suffix == ".json" else tomllib.load(source)
        if path == home / "config.toml" and len(paths) == 2 and config.get("profile"):
            paths.append(home / f'{config["profile"]}.config.toml')
        tables = [config.get("hooks", {})]
        # Legacy inline profiles share their source file's hook state keys.
        tables += [profile.get("hooks", {}) for profile in config.get("profiles", {}).values()]
        for hooks in tables:
            for event, groups in hooks.items():
                if event == "state" or not isinstance(groups, list):
                    continue
                label = re.sub(r"(?<!^)(?=[A-Z])", "_", event).lower()
                for group_index, group in enumerate(groups):
                    for handler_index, _ in enumerate(group.get("hooks", [])):
                        key = f"{path}:{label}:{group_index}:{handler_index}"
                        states[key] = "{enabled=false}"
    if not states:
        return []
    # CLI dotted-key parsing splits dots even inside quoted path components.
    # Put source keys inside a TOML table value so hooks.json remains one key.
    table = ",".join(f"{json.dumps(key)}={value}" for key, value in states.items())
    return ["-c", f"hooks.state={{{table}}}"]


def main():
    binary, *arguments = sys.argv[1:]
    home = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))).resolve()
    try:
        flags = overrides(home, arguments)
    except (OSError, ValueError, TypeError, AttributeError) as error:
        print(f"Codegenbox could not isolate user Codex hooks: {error}", file=sys.stderr)
        return 1
    # Last config override wins; keep literal prompt arguments after -- intact.
    index = arguments.index("--") if "--" in arguments else len(arguments)
    arguments[index:index] = flags
    os.execv(binary, [binary, *arguments])


if __name__ == "__main__":
    sys.exit(main())
